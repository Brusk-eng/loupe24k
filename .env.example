# ERPNext Docker Environment Configuration
# ==========================================

# Docker image configuration
CUSTOM_IMAGE=loupe24k-erpnext
CUSTOM_TAG=v16
PULL_POLICY=missing

# ERPNext version (used during image build)
# Default is ERPNext/Frappe v16. To run on v15 instead, flip both of these
# to version-15, set CUSTOM_TAG=v15 above, and run `make build` again.
ERPNEXT_VERSION=version-16
FRAPPE_VERSION=version-16

# Database
DB_PASSWORD=ChangeMe_StrongPassword_123!

# Site configuration
SITE_NAME=loupe24k.localhost
ADMIN_PASSWORD=ChangeMe_Admin_123!

# Port
HTTP_PUBLISH_PORT=8080
